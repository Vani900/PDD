{
  "name": "brainbattle-appium",
  "version": "1.0.0",
  "description": "Mobile E2E Appium 1111-test suite with custom WebDriverIO & Excel/HTML reporting",
  "main": "wdio.conf.js",
  "scripts": {
    "test": "wdio run wdio.conf.js",
    "test:ci": "bash scripts/ci_run_tests.sh",
