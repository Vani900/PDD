    "@wdio/mocha-framework": "^8.38.0",
    "@wdio/spec-reporter": "^8.38.0",
    "appium": "^2.11.3",
    "appium-uiautomator2-driver": "^3.7.8",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "chai": "^4.3.10"
  },
  "keywords": [
    "appium",
    "webdriverio",
    "android",
    "testing",
    "e2e",
    "exceljs"
