# CharityAI – Git Ignore
# =============================================================================

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
firebase-credentials.json
google-credentials.json
service-account.json

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv/
venv/
env/
ENV/
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ── Node.js / Next.js ─────────────────────────────────────────────────────────
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ── Android ───────────────────────────────────────────────────────────────────
android/.gradle/
android/local.properties
android/app/build/
android/*.apk
android/*.aab
android/keystore/
*.jks

# ── Docker ────────────────────────────────────────────────────────────────────
.dockerignore

# ── Terraform ─────────────────────────────────────────────────────────────────
infrastructure/terraform/.terraform/
infrastructure/terraform/*.tfstate
infrastructure/terraform/*.tfstate.backup
infrastructure/terraform/.terraform.lock.hcl
infrastructure/terraform/terraform.tfvars

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Test artifacts ────────────────────────────────────────────────────────────
test-results/
coverage/
.coverage
htmlcov/

# ── Build artifacts ───────────────────────────────────────────────────────────
dist/
build/
*.whl
*.tsbuildinfo

