# =============================================================================
# CharityAI – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=CharityAI
APP_ENV=development           # development | staging | production
APP_VERSION=1.0.0
APP_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
DEBUG=true
LOG_LEVEL=INFO

# ── Backend API ───────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
API_V1_PREFIX=/api/v1

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=charityai
POSTGRES_USER=charityai_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql+asyncpg://charityai_user:CHANGE_ME_STRONG_PASSWORD@localhost:5432/charityai
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0
REDIS_CACHE_TTL=3600

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=charityai
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_VHOST=/charityai
CELERY_BROKER_URL=amqp://charityai:CHANGE_ME_RABBITMQ_PASSWORD@localhost:5672//charityai
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/1

# ── Elasticsearch ─────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=CHANGE_ME_ELASTIC_PASSWORD

# ── JWT Authentication ────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── OAuth2 ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
MICROSOFT_CLIENT_ID=CHANGE_ME_MICROSOFT_CLIENT_ID
MICROSOFT_CLIENT_SECRET=CHANGE_ME_MICROSOFT_CLIENT_SECRET
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/auth/microsoft/callback

# ── AWS S3 / Cloudflare R2 ────────────────────────────────────────────────────
STORAGE_PROVIDER=s3              # s3 | r2 | minio
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=ap-south-1
AWS_S3_BUCKET=charityai-assets
AWS_S3_ENDPOINT_URL=             # Leave empty for AWS, set for R2/MinIO
CDN_BASE_URL=https://cdn.charityai.org

# ── Minio (local dev) ─────────────────────────────────────────────────────────
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_ENDPOINT=http://localhost:9000

# ── Email (SendGrid) ──────────────────────────────────────────────────────────
EMAIL_PROVIDER=sendgrid          # sendgrid | smtp
SENDGRID_API_KEY=CHANGE_ME_SENDGRID_API_KEY
EMAIL_FROM=noreply@charityai.org
EMAIL_FROM_NAME=CharityAI

# SMTP fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_EMAIL
SMTP_PASSWORD=CHANGE_ME_EMAIL_PASSWORD
SMTP_TLS=true

# ── SMS (Twilio) ──────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=CHANGE_ME_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=CHANGE_ME_TWILIO_AUTH_TOKEN
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ── Firebase (FCM push notifications) ────────────────────────────────────────
FIREBASE_PROJECT_ID=CHANGE_ME_FIREBASE_PROJECT_ID
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# ── AI Providers ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-pro

# ── Payment Gateways ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=CHANGE_ME_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=CHANGE_ME_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=CHANGE_ME_STRIPE_WEBHOOK_SECRET
RAZORPAY_KEY_ID=CHANGE_ME_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=CHANGE_ME_RAZORPAY_KEY_SECRET
PAYPAL_CLIENT_ID=CHANGE_ME_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=CHANGE_ME_PAYPAL_CLIENT_SECRET
PAYPAL_MODE=sandbox              # sandbox | live

# ── Google Maps ───────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=CHANGE_ME_GOOGLE_MAPS_API_KEY
GOOGLE_MAPS_ANDROID_KEY=CHANGE_ME_GOOGLE_MAPS_ANDROID_KEY

# ── WhatsApp (Meta Cloud API) ─────────────────────────────────────────────────
WHATSAPP_API_TOKEN=CHANGE_ME
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
WHATSAPP_VERIFY_TOKEN=CHANGE_ME

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_GOOGLE_MAPS_KEY=CHANGE_ME_GOOGLE_MAPS_API_KEY
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=CHANGE_ME_STRIPE_PUBLISHABLE_KEY
NEXT_PUBLIC_FIREBASE_API_KEY=CHANGE_ME
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=CHANGE_ME.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=CHANGE_ME_FIREBASE_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=CHANGE_ME.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=CHANGE_ME
NEXT_PUBLIC_FIREBASE_APP_ID=CHANGE_ME
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Android ───────────────────────────────────────────────────────────────────
ANDROID_BASE_URL=http://10.0.2.2:8000/api/v1/
ANDROID_KEYSTORE_PASSWORD=CHANGE_ME
ANDROID_KEY_ALIAS=charityai
ANDROID_KEY_PASSWORD=CHANGE_ME

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=CHANGE_ME_SENTRY_DSN
PROMETHEUS_METRICS_ENABLED=true
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
DATADOG_API_KEY=CHANGE_ME_DATADOG_KEY

# ── Feature Flags ─────────────────────────────────────────────────────────────
FEATURE_AI_CHATBOT=true
FEATURE_BIOMETRIC_LOGIN=true
FEATURE_DISASTER_MODE=false
FEATURE_GAMIFICATION=true
FEATURE_VOICE_ASSISTANT=false
FEATURE_CARBON_TRACKING=true
